# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temp files
tmp/
temp/
*.tmp

# Kubernetes secrets (DO NOT COMMIT)
secrets/
secret*.yaml
secret*.yml
repo-secret*.yaml
repo-secret*.yml
*.pem
*.key
*.crt
*.p12
*.pfx

# SOPS
*.dec.yaml
*.dec.yml

# Helm
# Subcharts downloaded by `helm dependency build`. NOT versioned: Chart.lock pins
# the versions and ArgoCD's repo-server resolves them at sync time.
# (The old "charts/**/charts/" pattern was anchored at the repo root and so never
# matched <tier>/<service>/charts/.)
**/charts/*.tgz
**/tmpcharts/
**/charts/**/.helmignore

# Helm secrets plugin
*.yaml.dec
*.yml.dec

# Kustomize build output
build/
dist/
rendered/
*.rendered.yaml

# ArgoCD generated files
.argocd-source.yaml

# Environment files
.env
.env.*

# Backup files
*.bak
*.backup

# Generated kubeconfig
kubeconfig
kubeconfig.yaml

.claude
# Neptune extracts: contain real personal data (affected_user, reported_by, tenant).
# Anonymise and commit deliberately, or keep them out.
migration/neptune/responses/*.json

# Local venv for the migration scripts
migration/scripts/.venv/

__pycache__/
*.pyc
